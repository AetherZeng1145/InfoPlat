<template>
  <div class="page {{ isDark ? 'page-dark' : 'page-light' }}">
    <div class="side-bar {{ isDark ? 'side-bar-dark' : 'side-bar-light' }}">
      <div class="brand-block">
        <text class="brand-en">INFOPLAT</text>
        <text class="brand-title {{ isDark ? 'text-dark' : 'text-light' }}">信息台</text>
      </div>

      <div class="time-block">
        <text class="time-text {{ isDark ? 'text-dark' : 'text-light' }}">{{ currentTime }}</text>
        <text class="mode-text {{ isDark ? 'text-dark-sub' : 'text-light-sub' }}">{{ modeLabel }}</text>
      </div>

      <div class="nav-block">
        <input class="{{ newsNavClass }} {{ isDark ? 'btn-dark' : 'btn-light' }}" type="button" value="新闻" onclick="showNews" />
        <input class="{{ weatherNavClass }} {{ isDark ? 'btn-dark' : 'btn-light' }}" type="button" value="天气" onclick="showWeather" />
        <input class="{{ expressNavClass }} {{ isDark ? 'btn-dark' : 'btn-light' }}" type="button" value="快递" onclick="showExpress" />
      </div>

      <input class="theme-button {{ isDark ? 'theme-btn-dark' : 'theme-btn-light' }}" type="button" value="{{ themeButtonText }}" onclick="toggleTheme" />
    </div>

    <div class="main-panel {{ isDark ? 'main-panel-dark' : 'main-panel-light' }}">
      <div class="action-row">
        <scroll class="category-scroll" scroll-x="true" scroll-y="false" bounces="true" if="{{ showNewsPanel }}">
          <div class="category-track">
            <input class="{{ politicsCategoryClass }} {{ isDark ? 'btn-dark' : 'btn-light' }}" type="button" value="综合热点" onclick="loadNewsPolitics" />
            <input class="{{ worldCategoryClass }} {{ isDark ? 'btn-dark' : 'btn-light' }}" type="button" value="国际新闻" onclick="loadNewsWorld" />
            <input class="{{ techCategoryClass }} {{ isDark ? 'btn-dark' : 'btn-light' }}" type="button" value="科技新闻" onclick="loadNewsTech" />
            <input class="{{ businessCategoryClass }} {{ isDark ? 'btn-dark' : 'btn-light' }}" type="button" value="财经新闻" onclick="loadNewsBusiness" />
            <input class="{{ sportsCategoryClass }} {{ isDark ? 'btn-dark' : 'btn-light' }}" type="button" value="体育新闻" onclick="loadNewsSports" />
            <input class="{{ entertainmentCategoryClass }} {{ isDark ? 'btn-dark' : 'btn-light' }}" type="button" value="娱乐新闻" onclick="loadNewsEntertainment" />
            <input class="{{ scienceCategoryClass }} {{ isDark ? 'btn-dark' : 'btn-light' }}" type="button" value="科学新闻" onclick="loadNewsScience" />
            <input class="{{ healthCategoryClass }} {{ isDark ? 'btn-dark' : 'btn-light' }}" type="button" value="健康新闻" onclick="loadNewsHealth" />
          </div>
        </scroll>
        <input class="refresh-button" type="button" value="{{ actionText }}" onclick="refreshCurrent" />
      </div>

      <div class="state-box" if="{{ loading }}">
        <text class="state-title {{ isDark ? 'text-dark' : 'text-light' }}">正在加载</text>
        <text class="state-text {{ isDark ? 'text-dark-sub' : 'text-light-sub' }}">{{ stateText }}</text>
      </div>

      <div class="state-box" if="{{ hasError }}">
        <text class="state-title error-title">加载失败</text>
        <text class="state-text {{ isDark ? 'text-dark-sub' : 'text-light-sub' }}">{{ errorText }}</text>
      </div>

      <scroll class="news-panel" scroll-y="true" bounces="true" if="{{ showNewsContent }}">
        <div class="lead-news {{ isDark ? 'card-dark' : 'card-light' }}" onclick="showDetail(leadNews)">
          <text class="lead-title {{ isDark ? 'text-dark' : 'text-light' }}">{{ leadNews.title }}</text>
          <text class="lead-desc {{ isDark ? 'text-dark-sub' : 'text-light-sub' }}">{{ leadNews.description }}</text>
          <text class="lead-source {{ isDark ? 'text-dark-sub' : 'text-light-sub' }}">{{ leadNews.source }} {{ leadNews.published }}</text>
        </div>
        <div class="news-grid">
          <div class="news-item {{ isDark ? 'card-dark' : 'card-light' }}" for="{{ newsList }}" onclick="showDetail($item)">
            <text class="news-item-title {{ isDark ? 'text-dark' : 'text-light' }}">{{ $item.title }}</text>
            <text class="news-item-desc {{ isDark ? 'text-dark-sub' : 'text-light-sub' }}">{{ $item.description }}</text>
            <text class="news-item-source {{ isDark ? 'text-dark-sub' : 'text-light-sub' }}">{{ $item.source }}</text>
          </div>
        </div>
      </scroll>

      <scroll class="data-panel {{ isDark ? 'card-dark' : 'card-light' }}" scroll-y="true" bounces="true" if="{{ showWeatherContent }}">
        <text class="data-kicker">{{ weatherInfo.subtitle }}</text>
        <text class="data-title {{ isDark ? 'text-dark' : 'text-light' }}">{{ weatherInfo.title }}</text>
        <text class="data-main">{{ weatherInfo.message }}</text>
        <div class="detail-list">
          <text class="detail-line {{ isDark ? 'text-dark-sub' : 'text-light-sub' }}" for="{{ weatherInfo.details }}">{{ $item }}</text>
        </div>
      </scroll>

      <div class="express-panel {{ isDark ? 'card-dark' : 'card-light' }}" if="{{ showExpressContent }}">
        <div class="express-input-row">
          <div class="express-input {{ isDark ? 'input-dark' : 'input-light' }}" onclick="toggleKeyboard">
            <text class="{{ trackingNo ? 'express-input-text' : 'express-input-placeholder' }}">{{ trackingNo || '请输入快递运单号' }}</text>
          </div>
          <input class="express-query-btn" type="button" value="查询" onclick="queryExpress" />
        </div>
        <div class="express-loading" if="{{ expressLoading }}">
          <text class="state-text {{ isDark ? 'text-dark-sub' : 'text-light-sub' }}">{{ expressStateText }}</text>
        </div>
        <scroll class="express-scroll" scroll-y="true" bounces="true" if="{{ !expressLoading &amp;&amp; !showKeyboard }}">
          <div class="express-info-row">
            <text class="express-tracking {{ isDark ? 'text-dark' : 'text-light' }}">{{ expressInfo.title }}</text>
            <text class="express-sep {{ isDark ? 'text-dark-sub' : 'text-light-sub' }}">|</text>
            <text class="express-cp {{ isDark ? 'text-dark-sub' : 'text-light-sub' }}">{{ expressInfo.subtitle }}</text>
            <text class="express-sep {{ isDark ? 'text-dark-sub' : 'text-light-sub' }}">|</text>
            <text class="express-status">{{ expressInfo.status }}</text>
          </div>
          <text class="express-msg {{ isDark ? 'text-dark-sub' : 'text-light-sub' }}">{{ expressInfo.message }}</text>
          <div class="timeline">
            <div class="timeline-item" for="{{ expressInfo.details }}">
              <div class="timeline-left">
                <div class="timeline-dot"></div>
                <div class="timeline-line"></div>
              </div>
              <div class="timeline-right">
                <text class="timeline-time {{ isDark ? 'text-dark-sub' : 'text-light-sub' }}">{{ $item.time }}</text>
                <text class="timeline-text {{ isDark ? 'text-dark' : 'text-light' }}">{{ $item.text }}</text>
              </div>
            </div>
          </div>
        </scroll>
        <div class="saved-section" if="{{ !expressLoading &amp;&amp; !showKeyboard }}">
          <text class="saved-title {{ isDark ? 'text-dark-sub' : 'text-light-sub' }}">保存的运单</text>
          <div class="saved-list">
            <div class="saved-item {{ isDark ? 'saved-item-dark' : '' }}" for="{{ savedList }}">
              <text class="saved-text {{ isDark ? 'text-dark' : 'text-light' }}" onclick="loadSaved($item)">{{ $item }}</text>
              <text class="saved-del" onclick="removeSaved($index)">×</text>
            </div>
          </div>
        </div>
        <div class="keyboard {{ isDark ? 'keyboard-dark' : '' }}" if="{{ showKeyboard }}">
          <div class="kb-row">
            <input class="kb-key" type="button" value="1" onclick="onKeyTap('1')" />
            <input class="kb-key" type="button" value="2" onclick="onKeyTap('2')" />
            <input class="kb-key" type="button" value="3" onclick="onKeyTap('3')" />
            <input class="kb-key" type="button" value="4" onclick="onKeyTap('4')" />
            <input class="kb-key" type="button" value="5" onclick="onKeyTap('5')" />
            <input class="kb-key" type="button" value="6" onclick="onKeyTap('6')" />
            <input class="kb-key" type="button" value="7" onclick="onKeyTap('7')" />
            <input class="kb-key" type="button" value="8" onclick="onKeyTap('8')" />
            <input class="kb-key" type="button" value="9" onclick="onKeyTap('9')" />
            <input class="kb-key" type="button" value="0" onclick="onKeyTap('0')" />
            <input class="kb-key" type="button" value="-" onclick="onKeyTap('-')" />
          </div>
          <div class="kb-row">
            <input class="kb-key" type="button" value="Q" onclick="onKeyTap('Q')" />
            <input class="kb-key" type="button" value="W" onclick="onKeyTap('W')" />
            <input class="kb-key" type="button" value="E" onclick="onKeyTap('E')" />
            <input class="kb-key" type="button" value="R" onclick="onKeyTap('R')" />
            <input class="kb-key" type="button" value="T" onclick="onKeyTap('T')" />
            <input class="kb-key" type="button" value="Y" onclick="onKeyTap('Y')" />
            <input class="kb-key" type="button" value="U" onclick="onKeyTap('U')" />
            <input class="kb-key" type="button" value="I" onclick="onKeyTap('I')" />
            <input class="kb-key" type="button" value="O" onclick="onKeyTap('O')" />
            <input class="kb-key" type="button" value="P" onclick="onKeyTap('P')" />
          </div>
          <div class="kb-row">
            <input class="kb-key" type="button" value="A" onclick="onKeyTap('A')" />
            <input class="kb-key" type="button" value="S" onclick="onKeyTap('S')" />
            <input class="kb-key" type="button" value="D" onclick="onKeyTap('D')" />
            <input class="kb-key" type="button" value="F" onclick="onKeyTap('F')" />
            <input class="kb-key" type="button" value="G" onclick="onKeyTap('G')" />
            <input class="kb-key" type="button" value="H" onclick="onKeyTap('H')" />
            <input class="kb-key" type="button" value="J" onclick="onKeyTap('J')" />
            <input class="kb-key" type="button" value="K" onclick="onKeyTap('K')" />
            <input class="kb-key" type="button" value="L" onclick="onKeyTap('L')" />
          </div>
          <div class="kb-row">
            <input class="kb-key" type="button" value="Z" onclick="onKeyTap('Z')" />
            <input class="kb-key" type="button" value="X" onclick="onKeyTap('X')" />
            <input class="kb-key" type="button" value="C" onclick="onKeyTap('C')" />
            <input class="kb-key" type="button" value="V" onclick="onKeyTap('V')" />
            <input class="kb-key" type="button" value="B" onclick="onKeyTap('B')" />
            <input class="kb-key" type="button" value="N" onclick="onKeyTap('N')" />
            <input class="kb-key" type="button" value="M" onclick="onKeyTap('M')" />
          </div>
          <div class="kb-row">
            <input class="kb-key-wide" type="button" value="退格" onclick="onKeyTap('DEL')" />
            <input class="kb-key-wide" type="button" value="清空" onclick="onKeyTap('CLR')" />
            <input class="kb-key-ok" type="button" value="确定" onclick="onKeyTap('OK')" />
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import { getLatestNews, getWeather, getExpress } from "../../common/services"

function pad(value) {
  return value < 10 ? "0" + value : "" + value
}

function emptyNews() {
  return {
    title: "暂无新闻",
    description: "请检查网络连接或 CurrentsAPI key。",
    source: "Currents",
    category: "综合",
    published: ""
  }
}

export default {
  private: {
    isDark: false,
    themeButtonText: "深色模式",
    modeLabel: "浅色",
    currentTime: "--:--",
    booted: false,
    activeTab: "news",
    activeCategory: "politics",
    actionText: "刷新",
    loading: false,
    hasError: false,
    stateText: "",
    errorText: "",
    showNewsPanel: true,
    showNewsContent: false,
    showWeatherContent: false,
    showExpressContent: false,
    newsNavClass: "nav-button nav-button-active",
    weatherNavClass: "nav-button",
    expressNavClass: "nav-button",
    politicsCategoryClass: "category-button category-button-active",
    worldCategoryClass: "category-button",
    techCategoryClass: "category-button",
    businessCategoryClass: "category-button",
    sportsCategoryClass: "category-button",
    entertainmentCategoryClass: "category-button",
    scienceCategoryClass: "category-button",
    healthCategoryClass: "category-button",
    leadNews: emptyNews(),
    newsList: [],
    trackingNo: "",
    expressLoading: false,
    expressStateText: "",
    showKeyboard: false,
    savedList: [],
    weatherInfo: {
      title: "天气服务待配置",
      subtitle: "聚合数据-全国天气预报",
      message: "等待接口 key",
      details: ["申请 juhe.cn 天气 key 后启用。"]
    },
    expressInfo: {
      title: "请输入运单号",
      subtitle: "tmini-快递查询",
      message: "请在下方输入框输入快递运单号进行查询",
      status: "",
      details: []
    }
  },

  onInit() {
    // Robust boolean check
    this.isDark = String(this.isDark) === "true"
    console.log("[InfoPlat] index onInit, isDark: " + this.isDark)
    this.boot()
  },

  onShow() {
    this.boot()
  },

  boot() {
    if (this.booted) {
      return
    }
    this.booted = true
    this.updateClock()
    this.loadSavedList()
    this.loadNewsPolitics()
    this.loadWeatherData()
    this.loadExpressData()
  },

  updateClock() {
    const now = new Date()
    this.currentTime = pad(now.getHours()) + ":" + pad(now.getMinutes())
  },

  toggleTheme() {
    this.isDark = !this.isDark
    this.themeButtonText = this.isDark ? "浅色模式" : "深色模式"
    this.modeLabel = this.isDark ? "深色" : "浅色"
    console.log("[InfoPlat] theme toggled, isDark: " + this.isDark)
  },

  showDetail(item) {
    if (!item || !item.title) return
    router.push({
      uri: "pages/detail",
      params: {
        title: item.title,
        description: item.description,
        source: item.source,
        url: item.url,
        isDark: this.isDark
      }
    })
  },

  refreshCurrent() {
    if (this.activeTab === "news") {
      this.reloadNews()
    } else if (this.activeTab === "weather") {
      this.loadWeatherData()
    } else {
      this.queryExpress()
    }
  },

  showNews() {
    this.setTab("news")
    if (!this.newsList.length) {
      this.loadNewsPolitics()
    }
  },

  showWeather() {
    this.setTab("weather")
  },

  showExpress() {
    this.setTab("express")
  },

  setTab(tab) {
    this.activeTab = tab
    this.hasError = false
    this.showNewsPanel = tab === "news"
    this.showNewsContent = tab === "news" && !this.loading && !this.hasError
    this.showWeatherContent = tab === "weather" && !this.loading && !this.hasError
    this.showExpressContent = tab === "express" && !this.loading && !this.expressLoading && !this.hasError
    this.newsNavClass = tab === "news" ? "nav-button nav-button-active" : "nav-button"
    this.weatherNavClass = tab === "weather" ? "nav-button nav-button-active" : "nav-button"
    this.expressNavClass = tab === "express" ? "nav-button nav-button-active" : "nav-button"
    this.actionText = tab === "express" ? "查询" : "刷新"
  },

  setCategory(category) {
    this.activeCategory = category
    this.politicsCategoryClass = category === "politics" ? "category-button category-button-active" : "category-button"
    this.worldCategoryClass = category === "world" ? "category-button category-button-active" : "category-button"
    this.techCategoryClass = category === "tech" ? "category-button category-button-active" : "category-button"
    this.businessCategoryClass = category === "business" ? "category-button category-button-active" : "category-button"
    this.sportsCategoryClass = category === "sports" ? "category-button category-button-active" : "category-button"
    this.entertainmentCategoryClass = category === "entertainment" ? "category-button category-button-active" : "category-button"
    this.scienceCategoryClass = category === "science" ? "category-button category-button-active" : "category-button"
    this.healthCategoryClass = category === "health" ? "category-button category-button-active" : "category-button"
  },

  loadNewsWorld() {
    this.setCategory("world")
    this.loadNews(["world"])
  },

  loadNewsTech() {
    this.setCategory("tech")
    this.loadNews(["technology"])
  },

  loadNewsBusiness() {
    this.setCategory("business")
    this.loadNews(["business", "finance"])
  },

  loadNewsSports() {
    this.setCategory("sports")
    this.loadNews(["sports"])
  },

  loadNewsEntertainment() {
    this.setCategory("entertainment")
    this.loadNews(["entertainment"])
  },

  loadNewsScience() {
    this.setCategory("science")
    this.loadNews(["science"])
  },

  loadNewsPolitics() {
    this.setCategory("politics")
    this.loadNews(["politics"])
  },

  loadNewsHealth() {
    this.setCategory("health")
    this.loadNews(["health"])
  },

  reloadNews() {
    if (this.activeCategory === "tech") {
      this.loadNewsTech()
    } else if (this.activeCategory === "business") {
      this.loadNewsBusiness()
    } else if (this.activeCategory === "world") {
      this.loadNewsWorld()
    } else if (this.activeCategory === "sports") {
      this.loadNewsSports()
    } else if (this.activeCategory === "entertainment") {
      this.loadNewsEntertainment()
    } else if (this.activeCategory === "science") {
      this.loadNewsScience()
    } else if (this.activeCategory === "politics") {
      this.loadNewsPolitics()
    } else if (this.activeCategory === "health") {
      this.loadNewsHealth()
    } else {
      this.loadNewsPolitics()
    }
  },

  loadNews(categories) {
    this.setTab("news")
    this.loading = true
    this.hasError = false
    this.stateText = "正在请求新闻"
    this.showNewsContent = false
    console.info("[InfoPlat] [Index] Loading news: " + categories.join(","))
    getLatestNews({
      categories: categories,
      pageSize: 50
    })
      .then((list) => {
        this.newsList = list.length > 1 ? list.slice(1) : []
        this.leadNews = list.length ? list[0] : emptyNews()
        this.loading = false
        this.showNewsContent = true
      })
      .catch((err) => {
        this.loading = false
        this.hasError = true
        this.errorText = "新闻获取失败: " + err.message
      })
  },

  loadWeatherData() {
    getWeather("北京").then((info) => {
      this.weatherInfo = info
      if (this.activeTab === "weather") {
        this.showWeatherContent = true
      }
    })
  },

  loadExpressData() {
    getExpress("").then((info) => {
      this.expressInfo = info
      if (this.activeTab === "express") {
        this.showExpressContent = true
      }
    })
  },

  toggleKeyboard() {
    this.showKeyboard = !this.showKeyboard
    console.info("[InfoPlat] Keyboard toggled: " + this.showKeyboard)
  },

  onKeyTap(key) {
    if (key === "DEL") {
      if (this.trackingNo.length > 0) {
        this.trackingNo = this.trackingNo.substring(0, this.trackingNo.length - 1)
      }
    } else if (key === "CLR") {
      this.trackingNo = ""
    } else if (key === "OK") {
      this.showKeyboard = false
    } else {
      this.trackingNo += key
    }
  },

  queryExpress() {
    var trackingNo = this.trackingNo.trim()
    if (!trackingNo) {
      this.expressInfo = {
        title: "请输入运单号",
        subtitle: "tmini-快递查询",
        message: "请在下方输入框输入快递运单号进行查询",
        status: "",
        details: []
      }
      return
    }

    console.info("[InfoPlat] Querying express: " + trackingNo)
    this.showKeyboard = false
    this.expressLoading = true
    this.expressStateText = "正在查询快递信息"
    this.hasError = false

    getExpress(trackingNo).then((info) => {
      this.expressInfo = info
      this.expressLoading = false
      this.saveToList(trackingNo)
      if (this.activeTab === "express") {
        this.showExpressContent = true
      }
    }).catch((err) => {
      this.expressLoading = false
      this.hasError = true
      this.errorText = "快递查询失败: " + err.message
    })
  },

  loadSavedList() {
    this.savedList = []
  },

  saveToList(trackingNo) {
    if (!trackingNo) return
    var list = this.savedList.filter(function (item) { return item !== trackingNo })
    list.unshift(trackingNo)
    if (list.length > 10) list = list.slice(0, 10)
    this.savedList = list
  },

  removeSaved(index) {
    var list = this.savedList.filter(function (_, i) { return i !== index })
    this.savedList = list
  },

  loadSaved(item) {
    this.trackingNo = item
    this.queryExpress()
  }

}
</script>

<style>
text {
  color: #172026;
  font-size: 20px;
  line-height: 26px;
}

.page {
  width: 800px;
  height: 600px;
  flex-direction: row;
}

.page-light {
  background-color: #f2f5f6;
}

.main-panel-light {
  background-color: #f2f5f6;
}

.side-bar-light,
.card-light {
  background-color: #ffffff;
}

.text-light {
  color: #172026;
}

.text-light-sub {
  color: #627279;
}

.side-bar {
  width: 224px;
  height: 600px;
  padding: 24px 20px;
  flex-direction: column;
}

.brand-block {
  height: 150px;
  flex-direction: column;
  justify-content: center;
}

.brand-en {
  font-size: 17px;
  color: #0074ff;
}

.brand-title {
  margin-top: 10px;
  height: 60px;
  line-height: 60px;
  font-size: 34px;
  font-weight: bold;
}

.time-block {
  height: 130px;
  margin-top: 8px;
  padding-top: 8px;
  flex-direction: column;
  justify-content: center;
}

.time-text {
  height: 66px;
  line-height: 66px;
  font-size: 42px;
  font-weight: bold;
}

.mode-text {
  margin-top: 6px;
  font-size: 18px;
}

.nav-block {
  height: 176px;
  margin-top: 18px;
  flex-direction: column;
}

.nav-button {
  width: 184px;
  height: 46px;
  margin-bottom: 14px;
  border-radius: 6px;
  background-color: #e8eef0;
  color: #172026;
  font-size: 22px;
  font-weight: bold;
}

.btn-light {
  background-color: #e8eef0;
  color: #172026;
}

.nav-button-active {
  background-color: #0074ff;
  color: #ffffff;
}

.theme-btn-light {
  background-color: #e6f1ff;
  color: #0057bf;
}

.theme-button {
  width: 184px;
  height: 42px;
  border-radius: 6px;
  font-size: 19px;
  font-weight: bold;
}

.main-panel {
  width: 576px;
  height: 600px;
