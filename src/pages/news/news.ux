  flex-direction: column;
  justify-content: space-between;
}

.news-item-title {
  font-size: 19px;
  line-height: 26px;
  font-weight: bold;
  lines: 2;
}

.news-item-desc {
  font-size: 15px;
  line-height: 22px;
  lines: 2;
  text-overflow: ellipsis;
}

.news-item-source {
  width: 233px;
  font-size: 14px;
  lines: 1;
  text-overflow: ellipsis;
  color: #999999;
}

.page-dark {
  background-color: #000000;
}

.main-panel-dark {
  background-color: #202020;
}

.side-bar-dark,
.card-dark {
  background-color: #171717;
}

.text-dark {
  color: #edf4f4;
}

.text-dark-sub {
  color: #aebdc2;
}

.btn-dark {
  background-color: #262626;
